# Loaded by Vite for `pnpm build` (mode=production), on top of .env.
#
# Every value here is PUBLIC: it is compiled into a bundle any visitor can read.
# The Google client id is public by design (§5.3) and the API base is a hostname
# people type. Nothing secret belongs in a VITE_ variable at all -- the client
# secret lives only in the backend.
#
# This file exists because .env holds the LOCAL values, and without an override
# a production build would bake in http://localhost:8080 and point the deployed
# app at the developer's laptop.
VITE_API_BASE_URL=https://api.quizzivy.com
VITE_GOOGLE_CLIENT_ID=825841392899-8aaqpsf9nt94usmovva6pifsqopk3dab.apps.googleusercontent.com
VITE_DEFAULT_LOCALE=vi
