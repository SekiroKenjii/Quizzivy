# Copy to .env and fill in. .env is gitignored and must stay that way.
# Every value here has a working dev default in docker-compose.yml, except the
# two marked BLOCKED, which need Thuong (T-0.2, T-0.3).

# ---------------------------------------------------------------- app
# spec §4: the literal appears once, here
APP_NAME=Quizzivy
APP_ENV=development
# storage is UTC; this is render-time only
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------- database
POSTGRES_SUPERUSER_PASSWORD=postgres
QUIZZIVY_MIGRATE_PASSWORD=migrate
QUIZZIVY_APP_PASSWORD=app
# The API connects as quizzivy_app -- never as the owner (spec §13.5).
DATABASE_URL=postgres://quizzivy_app:app@localhost:5432/quizzivy?sslmode=disable

# Admin connection string from the Neon console, used ONCE to provision the two
# roles. Not read by the app; only by scripts/provision-db.sh. Delete it after.
#   ./scripts/provision-db.sh "$NEON_ADMIN_URL"
NEON_ADMIN_URL=

# The two role-scoped Neon connection strings, produced by
# scripts/provision-db.sh. NEON_ADMIN_URL creates the roles; these two are what
# anything afterwards should use.
#
# NEON_MIGRATE_URL owns the schema: migrations, and the one-off bootstrap
# INSERT that cmd/seedadmin's doc comment describes. NEON_APP_URL is what the
# API connects as and owns nothing -- useful for checking, by hand, that a
# privilege really is denied (§13.5).
NEON_MIGRATE_URL=
NEON_APP_URL=

# ---------------------------------------------------------------- http
API_PORT=8080
# Exact origin allowlist. Never "*" -- illegal with credentials, and this API
# always sends them. app.* and api.* share a registrable domain, which is what
# makes the SameSite=Lax refresh cookie work (docs/plan/00-overview.md §4.1).
# 4173 is `vite preview`, which is what the live E2E suite runs against.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Names the ONE header carrying the real client address, or empty to use the
# socket. Only headers the infrastructure OVERWRITES are safe:
#   CF-Connecting-IP  behind Cloudflare's proxy
#   Fly-Client-IP     on Fly.io with the DNS record unproxied
# NEVER X-Forwarded-For -- proxies append to it, so a client can prepend a value
# and choose its own rate-limit bucket (§6.5). The server refuses to start if
# this is set to X-Forwarded-For.
CLIENT_IP_HEADER=

# ---------------------------------------------------------------- auth
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=
# Argon2id holds a 64 MiB arena for the duration of EVERY hash, so this is a
# memory limit in disguise: peak = this x 64 MiB. Measured, not estimated.
# On the 512 MB production machine, 8 concurrent hashes already exceed the whole
# instance -- and a class signing in together is thirty phones on thirty IPs, so
# the per-IP rate limit does not bound it. Raise this when the machine grows.
MAX_CONCURRENT_PASSWORD_HASHES=4
ACCESS_TOKEN_TTL=15m
# 30 days
REFRESH_TOKEN_TTL=720h
# Host-only cookie on the API host, Path=/auth (spec §5.2). No Domain attribute.
# true everywhere except plain-http localhost
REFRESH_COOKIE_SECURE=false

# BLOCKED on T-0.2 -- see docs/setup/google-oauth.md, then `make verify-google`.
# Public value; safe in the frontend bundle (spec §5.3). The BACKEND reads this
# same variable as the `aud` it verifies ID tokens against, unless
# GOOGLE_CLIENT_ID is set. One value, one name: two names is how they end up
# different, and the failure -- every Google sign-in rejected for a bad
# audience -- says nothing about the cause.
VITE_GOOGLE_CLIENT_ID=
# Backend only. Never exposed, never committed.
GOOGLE_CLIENT_SECRET=
# Must be registered under Authorized redirect URIs on the OAuth client.
# Comma-separated; matched EXACTLY at exchange time. Prefix matching on
# redirect URIs is the classic OAuth mistake -- it would let
# app.quizzivy.com.attacker.test through.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# All three Google values are optional AS A GROUP: unset, the deployment serves
# password login and /auth/google reports itself unavailable. Set some but not
# all and the server refuses to start, because half-configured fails in a way
# that looks like Google's fault.

# ---------------------------------------------------------------- object storage
# Local dev points at MinIO. Production points at R2; only the endpoint and
# credentials change (docs/plan/00-overview.md §4.7).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=quizzivy-media
S3_ACCESS_KEY_ID=quizzivy
S3_SECRET_ACCESS_KEY=quizzivy-dev-secret
# MinIO serves buckets as a path and needs this true. R2 serves them as a
# subdomain and needs it FALSE, which is also the default -- so a production
# deployment can leave the line out, and this line is here because local dev
# against MinIO cannot.
S3_FORCE_PATH_STYLE=true
# spec §11.2. Read by the server; the Cache-Control max-age on a signed-URL
# response is derived from this same value, so the two cannot disagree.
SIGNED_URL_TTL=10m

# BLOCKED on T-0.3 -- see docs/setup/r2.md, then `make verify-r2`.
#
# These three are read by `make verify-r2` ONLY. The server reads the S3_* names
# above and does not derive anything from R2_ACCOUNT_ID -- to point the server at
# real R2, set S3_ENDPOINT to
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# and leave S3_FORCE_PATH_STYLE unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- media limits
# 10 MB   (spec §11.1)
MEDIA_MAX_BYTES=10485760
# 5 min   (spec §11.1)
MEDIA_MAX_DURATION_MS=300000

# ---------------------------------------------------------------- rate limits
# spec §6.5. Per-IP and per-code, both enforced.
RATELIMIT_JOIN_PER_IP_MINUTE=10
RATELIMIT_JOIN_PER_IP_HOUR=60
RATELIMIT_JOIN_PER_CODE_HOUR=30

# ---------------------------------------------------------------- frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_DEFAULT_LOCALE=vi
