# Copy to .env and fill in. .env is gitignored and must stay that way.
# Every value here has a working dev default in docker-compose.yml, except the
# two marked BLOCKED, which need Thuong (T-0.2, T-0.3).

# ---------------------------------------------------------------- app
APP_NAME=Quizzivy                 # spec §4: the literal appears once, here
APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh     # storage is UTC; this is render-time only

# ---------------------------------------------------------------- database
POSTGRES_SUPERUSER_PASSWORD=postgres
QUIZZIVY_MIGRATE_PASSWORD=migrate
QUIZZIVY_APP_PASSWORD=app
# The API connects as quizzivy_app -- never as the owner (spec §13.5).
DATABASE_URL=postgres://quizzivy_app:app@localhost:5432/quizzivy?sslmode=disable

# ---------------------------------------------------------------- http
API_PORT=8080
# Exact origin allowlist. Never "*" -- illegal with credentials, and this API
# always sends them. app.* and api.* share a registrable domain, which is what
# makes the SameSite=Lax refresh cookie work (docs/plan/00-overview.md §4.1).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- auth
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h            # 30 days
# Host-only cookie on the API host, Path=/auth (spec §5.2). No Domain attribute.
REFRESH_COOKIE_SECURE=false       # true everywhere except plain-http localhost

# BLOCKED on T-0.2. Public value; safe in the frontend bundle (spec §5.3).
VITE_GOOGLE_CLIENT_ID=
# Backend only. Never exposed, never committed.
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- object storage
# Local dev points at MinIO. Production points at R2; only the endpoint and
# credentials change (docs/plan/00-overview.md §4.7).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=quizzivy-media
S3_ACCESS_KEY_ID=quizzivy
S3_SECRET_ACCESS_KEY=quizzivy-dev-secret
S3_FORCE_PATH_STYLE=true          # MinIO needs this; R2 does not
SIGNED_URL_TTL=10m                # spec §11.2

# BLOCKED on T-0.3. Fill these to point at real R2 instead of MinIO.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- media limits
MEDIA_MAX_BYTES=10485760          # 10 MB   (spec §11.1)
MEDIA_MAX_DURATION_MS=300000      # 5 min   (spec §11.1)

# ---------------------------------------------------------------- rate limits
# spec §6.5. Per-IP and per-code, both enforced.
RATELIMIT_JOIN_PER_IP_MINUTE=10
RATELIMIT_JOIN_PER_IP_HOUR=60
RATELIMIT_JOIN_PER_CODE_HOUR=30

# ---------------------------------------------------------------- frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_DEFAULT_LOCALE=vi
