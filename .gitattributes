# Generated from api/openapi.yaml by `make gen`. Never edit by hand; CI fails on
# drift. Marking them linguist-generated collapses them in review diffs, which
# keeps a contract change readable.
server/gen/**            linguist-generated=true
sdk/schema.d.ts          linguist-generated=true
sdk/operations.*         linguist-generated=true
sdk/openapi.*            linguist-generated=true
